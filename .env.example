MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
AUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# OAuth providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_ID=your-github-client-id
GITHUB_SECRET=your-github-client-secret

# Optional aliases supported by the app
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Email Service (optional - logs to console if omitted)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vivnt.com

# Payment

ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
# Sandbox by default; set the production URL when going live.
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
# Optional override; this UAT endpoint is selected automatically from ESEWA_PAYMENT_URL.
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
